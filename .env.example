# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the publishable key (sb_publishable_...). The legacy
# NEXT_PUBLIC_SUPABASE_ANON_KEY name is also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Used by admin/server actions that bypass RLS (vetting, rating rollup).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, no trailing slash (used for auth redirects + SEO/OG links).
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.vettedpages.com

# Pre-launch lock. Unset/false keeps the site locked to the landing page so the
# public can only join the waitlist (auth + /admin stay reachable for the owner).
# Set to true to open the full directory when you're ready to go live.
NEXT_PUBLIC_SITE_LAUNCHED=false
